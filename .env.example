# ==============================================================================
# LINK VERIFY AI — Environment Configuration Example
# Copy to `.env` (or `backend/.env` and `frontend/.env`) and populate values.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# --- Application ---
APP_NAME="LINK VERIFY AI"
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# For Supabase PostgreSQL or Docker PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/link_verify_ai
# Leave unset in local dev to fall back to SQLite (./link_verify_local.db).
DATABASE_URL=

# --- Authentication ---
# Set Supabase values to enable Supabase Auth + JWT verification.
# If SUPABASE_URL and SUPABASE_JWT_SECRET are omitted in local dev,
# the backend uses local JWT auth backed by the profiles table.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Local JWT secret (required in production when Supabase JWT secret is not set)
LOCAL_JWT_SECRET=change-this-to-a-long-random-secret-in-production
LOCAL_JWT_ALGORITHM=HS256
LOCAL_JWT_EXPIRE_MINUTES=1440

# --- Threat Intelligence API Keys (Backend Only — Never Expose to Browser) ---
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_AUTH_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=4.0
THREAT_INTEL_CACHE_TTL_SECONDS=900

# --- Rate Limiting & Risk Aggregation ---
RATE_LIMIT_SCAN_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=20
RISK_WEIGHT_ML=0.50
RISK_WEIGHT_HEURISTIC=0.35
RISK_WEIGHT_THREAT_INTEL=0.15

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

